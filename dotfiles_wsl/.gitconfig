[user]
	name = username
	email = youremail
	signingkey = ~/.ssh/id_ed25519.pub

[core]
    editor = code --wait

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[diff]
    tool = vscode

[difftool "vscode"]
    cmd = code --wait --diff "$LOCAL" "$REMOTE"

[merge]
    tool = vscode

[mergetool "vscode"]
    cmd = code --wait "$MERGED"

[url "git@github.com:"]
	insteadOf = https://github.com/

[gpg]
	format = ssh

[commit]
	gpgsign = true

[init]
	defaultBranch = main
